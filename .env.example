# ── LLM proxy (required) ─────────────────────────────────────────────────────
HAI_BASE_URL=https://your-hai-proxy/v1
HAI_API_KEY=your-key
HAI_MODEL=claude-sonnet-4-6

# ── SonarQube (required for API calls) ───────────────────────────────────────
# Generate at: https://sonar.tools.sap/account/security
SONAR_TOKEN=your-sonar-token
# SONAR_BASE_URL=https://sonar.tools.sap   # only change if using a different instance
