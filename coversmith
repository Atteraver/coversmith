#!/bin/bash
# coversmith — entry point script
# Re-execs itself under the venv Python so no manual `source .venv/bin/activate` needed.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python3"

if [ ! -x "$VENV_PYTHON" ]; then
    echo "Error: venv not found at $SCRIPT_DIR/.venv"
    echo ""
    echo "Run the one-time setup:"
    echo "  cd $SCRIPT_DIR"
    echo "  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
    exit 1
fi

exec "$VENV_PYTHON" "$SCRIPT_DIR/_coversmith.py" "$@"
